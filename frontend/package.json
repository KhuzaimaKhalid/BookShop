{
  "name": "shahid-book-depot",
  "private": true,
  "version": "1.0.0",
  "description": "Point of Sale system for Shahid Book Depot",
  "type": "module",
  "main": "main.js",
  "author": {
    "name": "Khuzaima Khalid",
    "company": "Trust Nexus"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http-get://localhost:5173 && npm run electron\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.trustnexus.shahidbookdepot",
    "productName": "Shahid Book Depot",
    "copyright": "Copyright © 2026 Trust Nexus / Khuzaima Khalid",
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "publisherName": "Trust Nexus",
      "icon": "src/assets/logo.ico"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "file-saver": "^2.0.5",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.6.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  }
}